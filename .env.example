# ── Model (Responses API: POST {OPENROUTER_BASE_URL}/responses) ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-6-luna
# JSON object merged into every request body as-is (snake_case). Lock the provider:
OPENROUTER_EXTRA_BODY={"provider":{"only":["openai"],"allow_fallbacks":false}}
# Optional extra request headers (JSON object)
# OPENROUTER_EXTRA_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"channel-agent-gateway"}
# OPENROUTER_TIMEOUT_MS=120000

# ── Web search / fetch tools (DeepSeek tool API). Tools are hidden when empty. ──
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Agent ──
# AGENT_TIMEZONE=Asia/Shanghai   # time zone of the [time｜scene｜sender] line on each message
AGENT_MAX_STEPS=40
# Must match maxDuration in vercel.json; the last step starts when < 90s are left
# AGENT_MAX_DURATION_SECONDS=300
# History is a safety cap, not a context budget (lists trim back once 25% over):
AGENT_HISTORY_LIMIT=100          # messages kept per private chat
AGENT_GROUP_HISTORY_LIMIT=200    # messages kept per group (everyone's messages); what an @ run sees
AGENT_HISTORY_TTL_DAYS=7         # a conversation is deleted after this many quiet days
# Ordinary (non-@) group messages, when GROUP_MESSAGE_CREATE is subscribed:
AGENT_AMBIENT_INTERVAL_SECONDS=10  # at most one agent run per group per window; 0 = record only
AGENT_AMBIENT_CONTEXT=40           # recent messages an ambient run sees

# ── QQ Bot (q.qq.com) ──
QQ_APP_ID=
QQ_APP_SECRET=

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Without @; required for the bot to answer in groups (only when mentioned)
TELEGRAM_BOT_USERNAME=

# ── Generic HTTP channel (disabled when empty) ──
HTTP_CHANNEL_TOKEN=

# ── Conversation store (Upstash Redis). Falls back to in-memory when empty. ──
# The Vercel Marketplace Upstash integration injects KV_REST_API_URL / KV_REST_API_TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Long-term memory (Upstash Vector, shared by every chat). Disabled when empty. ──
# Create the index with the hosted embedding model (text-embedding-3-small, 1536 dims).
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# ── Sandbox workspace (Vercel Sandbox + one Drive per chat) ──
# On by default on Vercel (OIDC); locally needs VERCEL_OIDC_TOKEN from `vercel env pull`.
# SANDBOX_ENABLED=0
# SANDBOX_REGION=iad1
# SANDBOX_COMMAND_TIMEOUT_SECONDS=60

# ── Stickers ──
# Defaults to the 梗鲸 archive CDN root; set to serve your own copies (same paths: meme/NNN.gif, 0_preview/meme/NNN.webp)
# STICKER_BASE_URL=https://img.aigengtu.com
